# ── Database (Supabase Postgres connection strings) ──────────────────────────
# Found in Supabase Project Settings -> Database. Use the "Connection pooling"
# string for DATABASE_URL and the direct connection for DIRECT_URL (Prisma
# needs the direct one for migrations).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[DB-HOST]:5432/postgres"

# ── Supabase Auth + Storage ───────────────────────────────────────────────────
# Found in Supabase Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-PUBLIC-KEY]"
# Server-only. NEVER expose this to the browser or commit it. Used for admin
# operations (e.g. the admin-role grant script).
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# Storage bucket name used for recipe photos/videos (create this bucket in
# Supabase Storage and make it public-read).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="recipe-media"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://kalabhavans.com"
